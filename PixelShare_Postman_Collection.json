{
	"info": {
		"_postman_id": "pixelshare-api-collection",
		"name": "PixelShare REST API",
		"description": "Postman Collection for PixelShare API endpoints (Posts CRUD operations)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get All Posts (GET /api/posts)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/posts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts"
					]
				},
				"description": "Retrieves all posts sorted by creation date (newest first)."
			},
			"response": []
		},
		{
			"name": "2. Create Post (POST /api/posts)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "form-data",
					"formdata": [
						{
							"key": "caption",
							"value": "Exploring sunset views! 🌅 #PixelShare",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/posts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts"
					]
				},
				"description": "Creates a new post. Uploads image to ImageKit cloud storage and saves details in MongoDB."
			},
			"response": []
		},
		{
			"name": "3. Get Single Post (GET /api/posts/:id)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/posts/:id",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts",
						":id"
					],
					"variable": [
						{
							"key": "id",
							"value": "65f1a2b3c4d5e6f789012345",
							"description": "MongoDB ObjectId of the post"
						}
					]
				},
				"description": "Retrieves a single post document by its MongoDB ObjectId."
			},
			"response": []
		},
		{
			"name": "4. Update Post (PATCH /api/posts/:id)",
			"request": {
				"method": "PATCH",
				"header": [],
				"body": {
					"mode": "form-data",
					"formdata": [
						{
							"key": "caption",
							"value": "Updated caption for sunset views! ✨ #Updated",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": [],
							"disabled": true
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/posts/:id",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts",
						":id"
					],
					"variable": [
						{
							"key": "id",
							"value": "65f1a2b3c4d5e6f789012345",
							"description": "MongoDB ObjectId of the post to update"
						}
					]
				},
				"description": "Updates caption and/or replaces the image asset on ImageKit."
			},
			"response": []
		},
		{
			"name": "5. Delete Post (DELETE /api/posts/:id)",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/posts/:id",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"posts",
						":id"
					],
					"variable": [
						{
							"key": "id",
							"value": "65f1a2b3c4d5e6f789012345",
							"description": "MongoDB ObjectId of the post to delete"
						}
					]
				},
				"description": "Deletes the post document from MongoDB and removes its image from ImageKit."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}
